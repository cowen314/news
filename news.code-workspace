{
	"folders": [
		{
			"path": ".",
		}
	],
	"settings": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "ms-python.vscode-pylance",
		// Start all terminals at the workspace root
		"terminal.integrated.splitCwd": "workspaceRoot",
		// Dock the toolbar at the bottom of the window
		"debug.toolBarLocation": "docked",
		// Use pretty colors
		"editor.bracketPairColorization.enabled": true,
		// Python-specific settings
		"python.languageServer": "Pylance",
		"python.analysis.diagnosticMode": "workspace",
		"python.analysis.typeCheckingMode": "basic",
		"[python]": {
			"editor.formatOnSave": true,
			"editor.defaultFormatter": "charliermarsh.ruff",
			"editor.codeActionsOnSave": {
				"source.fixAll": "explicit",
				"source.organizeImports": "explicit"
			}
		},
		"[json]": {
			"editor.defaultFormatter": "vscode.json-language-features"
		},
		"[jsonc]": {
			"editor.defaultFormatter": "vscode.json-language-features"
		},
	},
	"extensions": {
		"recommendations": [
			"charliermarsh.ruff"
		]
	},
	"launch": {
		"configurations": [
			{
				// Reads ANTHROPIC_API_KEY etc. from .env (gitignored) if present
				"name": "Digest: dry run",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/digest.py",
				"args": ["--dry-run"],
				"cwd": "${workspaceFolder}",
				"envFile": "${workspaceFolder}/.env",
				"console": "integratedTerminal"
			},
			{
				// Skips the model call; exercises the "newest N per topic" fallback
				"name": "Digest: dry run (no AI)",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/digest.py",
				"args": ["--dry-run"],
				"cwd": "${workspaceFolder}",
				"env": { "ANTHROPIC_API_KEY": "" },
				"console": "integratedTerminal"
			}
		],
		"compounds": []
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Set Anthropic API key",
				"type": "process",
				"command": "${command:python.interpreterPath}",
				"args": ["${workspaceFolder}/set_key.py"],
				"presentation": { "focus": true },
				"problemMatcher": []
			}
		]
	}
}